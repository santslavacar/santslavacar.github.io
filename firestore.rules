rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function admin() {
      return signed() && request.auth.token.email_verified == true
        && request.auth.token.email in ['gstsoares27@gmail.com', 'geovanesantosx1999@gmail.com'];
    }
    match /config/{id} {
      allow read: if true;
      allow write: if admin();
    }
    match /users/{uid} {
      allow read, write: if signed() && request.auth.uid == uid;
      allow read: if admin();
    }
    match /bookings/{id} {
      allow read: if admin() || (signed() && resource.data.clientId == request.auth.uid);
      allow create: if signed() && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == 'pendente';
      allow update: if admin() || (signed() && resource.data.clientId == request.auth.uid
        && request.resource.data.status == 'cancelado'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if admin();
    }
    // Ocupação por dia: só horários, sem dados do cliente.
    match /days/{date} {
      function onlyOwnItem() {
        let k = request.resource.data.lastKey;
        let n = request.resource.data.items;
        let o = resource.data.items;
        let ch = n.diff(o).affectedKeys();
        return ch.size() == 1 && ch.hasOnly([k]) && (
          (k in n && !(k in o) && n[k].uid == request.auth.uid)
          || (k in o && !(k in n) && o[k].uid == request.auth.uid));
      }
      allow read: if signed();
      allow create: if admin() || (signed() && request.resource.data.items.size() == 1
        && request.resource.data.items[request.resource.data.lastKey].uid == request.auth.uid);
      allow update: if admin() || (signed() && onlyOwnItem());
      allow delete: if admin();
    }
    match /vehicleRequests/{id} {
      allow create: if signed();
      allow read, delete: if admin();
    }
  }
}
